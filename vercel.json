{
  "version": 2,
  "buildCommand": "mkdir -p public && cp index.html admin.html style.css script.js requirements.txt CyberSafe-Installer.zip public/ 2>/dev/null; cp -r api public/ 2>/dev/null; exit 0",
  "outputDirectory": "public",
  "env": {
    "MONGODB_URI": "mongodb+srv://balabaskaran0107_db_user:CNm0gzEtvn9RlAku@cybersafe.httvgrv.mongodb.net/cybersafe?retryWrites=true&w=majority",
    "ADMIN_EMAIL": "admin@cybersafe.com",
    "ADMIN_PASSWORD": "password",
    "JWT_SECRET": "cybersafe_jwt_secret_key_2024"
  },
  "functions": {
    "api/track.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/stats.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/admin.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/track",
      "dest": "/api/track.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.js",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
